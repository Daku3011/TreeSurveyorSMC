# Flask App Configuration
SECRET_KEY=smc-tree-census-super-secret-key-change-in-production
FLASK_ENV=development

# Database Configuration (SQLite by default for instant local setup, or PostgreSQL)
DATABASE_URL=sqlite:///smc_tree_census.db
# PostgreSQL example:
# DATABASE_URL=postgresql://postgres:password@localhost:5433/smc_tree_census

# --- AI Tree Vision Configuration ---
# Option 1: OpenRouter API (Recommended - access to Gemini 2.5 Flash, GPT-4o-mini, Claude 3.5)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Best models for botanical tree analysis:
# - google/gemini-2.5-flash (Best: fastest, cheapest, excellent Gujarati & vision support)
# - openai/gpt-4o-mini (Great general vision & JSON accuracy)
# - anthropic/claude-3.5-sonnet (Highest precision)
OPENROUTER_MODEL=google/gemini-2.5-flash

# Option 2: Direct Google Gemini API Key (Alternative)
# Get your free key at: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# Option 3: Local Hugging Face Vision Transformer (ViT-B)
# Model: juppy44/plant-identification-2m-vit-b (14,000 botanical species)
# 1. Request access at: https://huggingface.co/juppy44/plant-identification-2m-vit-b
# 2. Add your Hugging Face User Access Token (from https://huggingface.co/settings/tokens):
# HF_TOKEN=your_huggingface_token_here

# Provider Preference (optional: 'juppy44', 'gemini', or 'openrouter'):
# AI_PROVIDER=juppy44
